{
  "name": "curecloud-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start",
    "seed": "node scripts/seed.js",
    "test": "firebase emulators:exec --project demo-curecloud --only auth,firestore \"VALIDATE_RESPONSES=1 node --test --test-concurrency=1 test/*.test.js\"",
    "deploy": "firebase deploy --only functions,firestore",
    "logs": "firebase functions:log",
    "migrate": "node scripts/migrate-v1.js",
    "openapi": "node scripts/openapi.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.4.0",
    "swagger-ui-dist": "^5.33.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^9.1.0",
    "firebase-tools": "^14.11.0",
    "supertest": "^7.1.0"
  }
}
