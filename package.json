{
  "name": "curecloud-backend",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start",
    "seed": "node scripts/seed.js",
    "test": "firebase emulators:exec --project demo-curecloud --only auth,firestore \"node --test test/*.test.js\"",
    "deploy": "firebase deploy --only functions,firestore",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "firebase-tools": "^14.11.0",
    "supertest": "^7.1.0"
  }
}
