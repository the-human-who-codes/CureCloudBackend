{
	"functions": [
		{
			"source": ".",
			"codebase": "default",
			"runtime": "nodejs22",
			"ignore": [
				"node_modules",
				".git",
				".github",
				"test",
				"scripts",
				"*.log",
				"firebase.json",
				"firestore.rules",
				"firestore.indexes.json",
				"README.md",
				".env.example",
				"mise.toml"
			]
		}
	],
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"emulators": {
		"auth": { "port": 9099 },
		"firestore": { "port": 8080 },
		"functions": { "port": 5001 },
		"ui": { "enabled": true, "port": 4000 },
		"singleProjectMode": true
	}
}
